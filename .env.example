# Port d'écoute hôte pour Docker Compose (par défaut : 3001)
APP_PORT=3001

# Environnement (production ou development)
NODE_ENV=production

# GEMINI_API_KEY: Requis pour les appels d'API Gemini AI (optionnel)
GEMINI_API_KEY=""

# APP_URL: URL publique de l'application (ex: http://localhost:3001 ou https://mon-domaine.fr)
APP_URL="http://localhost:3001"
